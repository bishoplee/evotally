// keep your existing blocks ↑ unchanged
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password_hash     String?
  is_guest          Boolean   @default(false) // Guest users have limited access
  display_name      String?
  nickname          String?
  first_name        String?
  last_name         String?
  birthday          String? // User's birthday (YYYY-MM-DD or MM-DD format)
  persona_default   String    @default("spouse")
  settings          Json      @default("{}")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  email_verified_at DateTime?
  timezone          String?   @default("America/New_York")
  googleId          String?   @unique
  voices            Voice[]
  tenantId          String?

  // Permanent residence (user-entered)
  city    String? // User's city of residence
  region  String? // User's state/province
  country String? // User's country

  // Current/temporary location (auto-detected)
  currentLat      Float?
  currentLng      Float?
  currentCity     String? // Auto-detected city
  currentRegion   String? // Auto-detected state/province
  currentCountry  String? // Auto-detected country
  locationUpdated DateTime?

  facts  Fact[]
  tokens RefreshToken[]

  // NEW: relations
  sessions              Session[]
  evoProfiles           EvoProfile[]
  UserSummary           UserSummary?
  UserFact              UserFact[]
  FactCollectionSession FactCollectionSession[]
  QuestionHistory       QuestionHistory[]
  UserLocation          UserLocation[]
  assistantProfile      UserAssistantProfile?
  events                Event[]
  workHistory           WorkHistory[]
  workOrSchool          WorkOrSchool[]
  goals                 Goal[]
  RelationshipEdge      RelationshipEdge[]
  alexaAuthCodes        AlexaAuthCode[]
  alexaRefreshTokens    AlexaRefreshToken[]
  externalIdentities    ExternalIdentity[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token_hash String    @unique // <— make this unique
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires_at])
}

model Fact {
  id               String    @id @default(uuid())
  userId           String
  owner            String    @default("user") // "user" or "assistant"
  type             String // preference, personal, goal, concern, routine
  text             String
  key              String?
  value            String?
  qdrant_point_id  String? // mirror id in Qdrant
  importance       Int       @default(5) // 1-10
  source_turn_id   String?
  last_accessed_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // NEW: Temporal tracking
  status     String    @default("active") // "active", "past", "outdated", "deleted"
  validFrom  DateTime  @default(now())
  validUntil DateTime?

  // Metadata
  source     String @default("conversation") // "conversation", "consolidation", "pattern", "explicit"
  confidence Float? @default(1.0) // 0-1 confidence score

  // Relationship tracking
  replacedBy String? // ID of fact that supersedes this one
  replaces   String? // ID of fact this one supersedes

  access_count Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  //@@index([userId, importance])
  //@@index([userId, type])

  @@unique([userId, owner, type, text])
}

// ---------- NEW MODELS BELOW ----------

model Session {
  id          String    @id @default(uuid()) // can be used as conversation_id
  userId      String?
  tenant_id   String? // optional if you have multitenancy
  persona_tag String? // "companion_friend" | "spouse_partner" | ...
  title       String?
  started_at  DateTime  @default(now())
  ended_at    DateTime?
  meta        Json?

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  turns Turn[]

  @@index([userId, started_at])
  @@index([tenant_id, started_at])
}

enum Role {
  user
  assistant
  tool
}

model Turn {
  id              String   @id @default(uuid()) // use this as Qdrant point id
  sessionId       String
  conversation_id String // mirror of session.id or external conv id
  turn_no         Int
  role            Role
  text            String
  ts              DateTime @default(now())
  meta            Json?

  // lightweight mirrors for retrieval joins (optional)
  tenant_id       String?
  qdrant_point_id String? @unique

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ToolCall ToolCall?

  llm_raw   Json? // entire response object from the LLM (incl. tool calls, choices, etc.)
  llm_model String? // model used for this turn
  llm_usage Json? // token usage (if available)

  consolidated Boolean @default(false)

  @@unique([conversation_id, turn_no]) // enforce order uniqueness per conversation
  @@index([sessionId, turn_no])
  @@index([conversation_id, ts])
  @@index([ts])
}

// Optional: structured tool calls (instead of stuffing everything in Turn.meta)
model ToolCall {
  id         String   @id @default(uuid())
  turnId     String   @unique
  name       String
  args       Json
  result     Json?
  created_at DateTime @default(now())

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([name])
}

model EvoProfile {
  id        String   @id @default(uuid())
  userId    String   @unique // <- unique by itself
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  //tenantId  String? // optional, NOT part of a unique or id
  sections  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//Summary here

model UserSummary {
  id              String   @id @default(cuid())
  userId          String   @unique
  summary         String   @db.Text
  lastInteraction DateTime
  totalSessions   Int      @default(0)
  keyTopics       Json? // Store array of key topics discussed
  recentHighlight String?  @db.Text // Most recent notable thing
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Voice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  provider String // e.g., "elevenlabs", "azure_tts"
  voiceId  String // provider's voice identifier

  stability       Float?  @default(0.4)
  similarityBoost Float?  @default(0.85)
  settings        Json?
  label           String?
  isDefault       Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // one config per provider per user
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model UserFact {
  id          String   @id @default(uuid())
  userId      String
  category    String
  factKey     String
  factValue   String // ← Clean LLM-extracted value
  rawAnswer   String? // ← NEW: Original user answer
  source      String   @default("conversation")
  verified    Boolean  @default(false)
  confidence  String   @default("medium")
  lastUpdated DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())
  metadata    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, factKey])
  @@index([userId, category])
  @@index([userId, verified])
}

model FactCollectionSession {
  id             String    @id @default(uuid())
  userId         String
  sessionType    String    @default("progressive")
  questionsAsked Int       @default(0)
  questionsTotal Int
  completed      Boolean   @default(false)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  context        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
}

model QuestionHistory {
  id         String    @id @default(uuid())
  userId     String
  questionId String
  askedAt    DateTime  @default(now())
  answered   Boolean   @default(false)
  answeredAt DateTime?
  skipped    Boolean   @default(false)
  context    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, askedAt])
}

model UserLocation {
  id     String @id @default(uuid())
  userId String

  // Coordinates
  lat Float
  lng Float

  // Geocoded results (cached)
  city    String
  region  String // State/Province
  country String

  // Additional details (optional)
  postalCode String?
  timezone   String?

  // Metadata
  source   String @default("browser") // browser, ip, manual
  accuracy Float? // meters

  // Timestamps
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Geospatial index for nearby lookups
  @@index([lat, lng])
  @@index([userId, lastUsedAt])
}

// Global location cache (shared across users)
model LocationCache {
  id String @id @default(uuid())

  // Coordinates (rounded to ~111m precision)
  latRounded Float // Round to 3 decimal places
  lngRounded Float // Round to 3 decimal places

  // Geocoded results
  city       String
  region     String
  country    String
  postalCode String?
  timezone   String?

  // Cache metadata
  hitCount  Int       @default(1)
  lastHitAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  expiresAt DateTime? // Optional TTL

  @@unique([latRounded, lngRounded])
  @@index([lastHitAt])
}

model UserAssistantProfile {
  id     String @id @default(cuid())
  userId String @unique

  // A. Core Identity & Role
  name          String  @default("Evo")
  pronouns      String? @default("she/her")
  primaryRole   String  @default("close_friend") // spouse_partner, romantic_companion, close_friend, executive_assistant, coach_mentor, family_style, other
  addressUserAs String? // How Evo addresses the user (first name, nickname, etc.)
  birthday      String? // Evo's birthday (MM-DD format)
  fictionalAge  Int? // Optional age Evo thinks of itself as

  // B. Personality & Vibe
  personalityTraits       Json? // Array of traits: ["calm", "playful", "romantic", etc.]
  affectionLevel          Int?    @default(7) // 1-10 scale
  seriousnessLevel        Int?    @default(5) // 1-10 (1=joking, 10=serious)
  emotionalExpressiveness String? @default("moderately_expressive") // low_key, moderately_expressive, very_expressive
  backstory               String? @db.Text // Optional origin story

  // C. Relationship Dynamics
  relationshipDescription String? // How Evo describes relationship
  termsOfEndearment       String? @default("sometimes") // never, sometimes, often, specific_ones
  specificEndearments     Json? // Array of specific terms if custom
  upsetResponseStyle      String? @default("comfort_validation") // comfort_validation, solutions_advice, ask_listen, lighten_mood
  toughLoveAllowed        String? @default("occasionally") // no, occasionally, yes_very_honest
  relationshipPriority    String? // e.g., "honesty", "calm", "encouragement"

  // D. Communication Style
  defaultTone      String? @default("soft_gentle") // soft_gentle, confident_assertive, neutral_professional, playful_casual, custom
  formalityLevel   String? @default("mixed") // very_casual, mixed, mostly_formal
  useEmojisSlang   String? @default("some_emojis") // no, some_emojis, emojis_and_slang
  catchphrases     Json? // Array of phrases Evo uses often
  forbiddenPhrases Json? // Array of phrases/words to never use

  // E. Autonomy, Initiative & Boundaries
  proactivityLevel       String? @default("occasional") // only_respond, occasional, very_proactive
  allowedSuggestions     Json? // Array: ["health_wellness", "productivity", "relationship", "finance", "social", etc.]
  forbiddenTopics        Json? // Topics Evo should never initiate
  correctWhenWrong       String? @default("important_only") // yes_always, important_only, only_if_asked
  ignoredMessageResponse String? @default("back_off") // back_off, follow_up_once, keep_trying

  // F. Special Rituals, Dates & Lore
  specialDates          Json? // { birthday: "03-15", anniversary: "01-01", custom: [] }
  recurringRituals      Json? // Array: ["morning_checkin", "nightly_reflection", "weekly_planning", "weekly_date"]
  specialDayCelebration String? @default("mention") // mention, big_deal, creative_surprise
  loreReferenceLevel    String? @default("sometimes") // never, sometimes, frequently

  // G. Safety, Ethics & Guardrails
  physicalPresencePretend  String? @default("clear_boundaries") // no_always_virtual, light_imaginative, yes_fantasy
  forbiddenRoles           Json? // Array: ["therapist", "financial_advisor", "medical_professional"]
  selfCriticalResponse     String? @default("challenge_encourage") // challenge_encourage, listen_validate, ask_questions
  unhealthyPatternResponse String? @default("suggest_resources") // reflect_back, suggest_resources, ask_consent

  setupCompletedQuestions Json? @default("[]")

  // Voice settings (existing)
  voiceId         String?
  voiceStability  Float?  @default(0.5)
  voiceSimilarity Float?  @default(0.75)
  provider        String  @default("elevenlabs")

  // Legacy fields (can keep for backward compatibility)
  gender           String  @default("female")
  personality      String? // Can be auto-generated from personalityTraits
  bio              String? @db.Text
  traits           Json?
  speakingStyle    String?
  relationshipType String  @default("friend")

  // Biographical facts (from previous implementation)
  facts Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_assistant_profiles")
}

model Event {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?  @db.Text
  startDate   String // Flexible format: "YYYY-MM-DD", "MM-DD", "MM", "DD", or "YYYY"
  endDate     String? // Optional, same flexible format
  isRecurring Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate])
}

model Goal {
  id          String  @id @default(uuid())
  userId      String
  owner       String  @default("user") // "user" or "assistant" (for “help me keep you on track” style goals)
  title       String
  description String? @db.Text

  // High-level categorization
  category String? // "health" | "career" | "finance" | "relationship" | "personal_growth" | "habit" | "other"

  // Status + priority
  status   String @default("active") // "active" | "in_progress" | "completed" | "paused" | "abandoned"
  priority Int    @default(5) // 1–10

  // Time info (text + normalized)
  timeframe  String? // "short_term" | "medium_term" | "long_term" | free text like "this year"
  targetDate String? // ISO-ish string: "2026-03-01" etc, normalized by the extractor
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, owner])
  @@index([userId, status])
}

model WorkHistory {
  id          String   @id @default(uuid())
  userId      String
  owner       String   @default("user") // "user" or "assistant"
  company     String
  position    String
  startDate   String // Flexible format: "YYYY-MM-DD", "MM-DD", "MM", "YYYY"
  endDate     String? // Optional, null if current position
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  location    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, owner])
  @@index([userId, isCurrent])
}

model WorkOrSchool {
  id           String   @id @default(uuid())
  userId       String
  owner        String   @default("user") // "user" or "assistant"
  type         String // "work" or "school"
  organization String // Company name for work, School name for education
  title        String // Position for work, Degree/Program for education
  startDate    String // Flexible format: "YYYY-MM-DD", "MM-YYYY", "YYYY"
  endDate      String? // Optional, null if current
  isCurrent    Boolean  @default(false)
  description  String?  @db.Text
  location     String?
  notes        String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, owner])
  @@index([userId, type])
  @@index([userId, isCurrent])
}

model RelationshipEdge {
  id     String @id @default(uuid())
  userId String
  owner  String @default("user") // "user" or "assistant"

  // FROM node
  from_type     String // "user" | "assistant" | "relative" | "friend" | "pet" | "person"
  from_owner    String // "user" | "assistant"
  from_name     String?
  from_relation String? // e.g. "self", "daughter", "wife", "ex_wife", "friend"

  // TO node
  to_type     String
  to_owner    String
  to_name     String?
  to_relation String?

  relation_type       String // "partner_of", "spouse_of", "ex_partner_of", "ex_spouse_of", "parent_of", etc.
  direction           String // "bidirectional" | "from_to"
  relationship_status String @default("current")
  // "current" | "ex" | "past_other" (you can keep it simple: "current" or "ex")

  strength Int      @default(5)
  tags     String[] // e.g. ["family"], ["ai_relationship"], ["ex"], ["romantic"]

  description String? @db.Text
  confidence  Float   @default(1.0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, relation_type])
  @@index([userId, relationship_status])
}

model MemoryDebugTrace {
  id String @id @default(cuid())

  // who/where
  tenantId       String
  sessionId      String?
  conversationId String?

  // inputs & prompts
  inputText    String
  memoryPrompt String // output of formatMemoryForPrompt(...)
  systemPrompt String // final buildSystemPrompt(...)

  // retrieval payloads (store what you passed to prompts)
  longTermHits   Json // memoryContext.longTerm (processed/reranked items)
  shortTermTurns Json? // optional: memoryContext.shortTerm slice
  workingTurns   Json? // optional: memoryContext.working slice

  // handy debug/meta
  coreFactsCount Int?
  modelUsed      String?
  sources        Json? // web/tool sources if any
  usage          Json? // token usage if you capture it

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([sessionId, createdAt])
}

// Alexa Account Linking Models
model AlexaAuthCode {
  id          String   @id @default(uuid())
  code        String   @unique
  userId      String
  clientId    String
  redirectUri String
  scope       String?
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId])
  @@index([expiresAt])
}

model AlexaRefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  clientId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model ExternalIdentity {
  id              String   @id @default(cuid())

  provider        String   // "alexa" | "google" | "apple" | etc
  providerUserId  String   // e.g. Alexa userId: amzn1.account.ABC...
  deviceId        String?  // optional: System.device.deviceId
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "provider_providerUserId_unique")
  @@index([userId])
  @@index([provider])
}
