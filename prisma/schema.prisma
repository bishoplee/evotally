// keep your existing blocks ↑ unchanged
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password_hash     String
  display_name      String?
  nickname          String?
  first_name        String?
  last_name         String?
  persona_default   String    @default("spouse")
  settings          Json      @default("{}")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  email_verified_at DateTime?
  timezone          String?   @default("America/New_York")
  voices            Voice[]
  tenantId          String?

  facts  Fact[]
  tokens RefreshToken[]

  // NEW: relations
  sessions    Session[]
  evoProfiles EvoProfile[]
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  token_hash String   @unique       // <— make this unique
  created_at DateTime @default(now())
  expires_at DateTime
  revoked_at DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires_at])
}

model Fact {
  id              String   @id @default(uuid())
  userId          String
  type            String // "trait" | "preference" | "bio" | "goal" | "note"
  key             String? // e.g., favorite_cuisine
  value           String? // e.g., Thai
  text            String // full text
  qdrant_point_id String? // mirror id in Qdrant
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- NEW MODELS BELOW ----------

model Session {
  id          String    @id @default(uuid()) // can be used as conversation_id
  userId      String?
  tenant_id   String? // optional if you have multitenancy
  persona_tag String? // "companion_friend" | "spouse_partner" | ...
  title       String?
  started_at  DateTime  @default(now())
  ended_at    DateTime?
  meta        Json?

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  turns Turn[]

  @@index([userId, started_at])
  @@index([tenant_id, started_at])
}

enum Role {
  user
  assistant
  tool
}

model Turn {
  id              String   @id @default(uuid()) // use this as Qdrant point id
  sessionId       String
  conversation_id String // mirror of session.id or external conv id
  turn_no         Int
  role            Role
  text            String
  ts              DateTime @default(now())
  meta            Json?

  // lightweight mirrors for retrieval joins (optional)
  tenant_id       String?
  qdrant_point_id String? @unique

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ToolCall ToolCall?

  @@unique([conversation_id, turn_no]) // enforce order uniqueness per conversation
  @@index([sessionId, turn_no])
  @@index([conversation_id, ts])
  @@index([ts])
}

// Optional: structured tool calls (instead of stuffing everything in Turn.meta)
model ToolCall {
  id         String   @id @default(uuid())
  turnId     String   @unique
  name       String
  args       Json
  result     Json?
  created_at DateTime @default(now())

  turn Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([name])
}

model EvoProfile {
  id        String   @id @default(uuid())
  userId    String   @unique // <- unique by itself
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  //tenantId  String? // optional, NOT part of a unique or id
  sections  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Voice {
  id              String   @id @default(cuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  provider        String   // e.g., "elevenlabs", "azure_tts"
  voiceId         String   // provider's voice identifier

  stability       Float?   @default(0.4)
  similarityBoost Float?   @default(0.85)
  settings        Json?
  label           String?
  isDefault       Boolean  @default(false)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // one config per provider per user
  @@unique([userId, provider])

  @@index([userId])
  @@index([provider])
}



